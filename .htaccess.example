RewriteEngine On

RewriteRule ^annuaire/?$ /HffintranetMigr/annuaire [L,QSA]
RewriteRule ^annuaire/(.*)$ /HffintranetMigr/annuaire [L,QSA]
RewriteRule ^taux-de-change/?$ /HffintranetMigr/taux-de-change [L,QSA]
RewriteRule ^taux-de-change/(.*)$ /HffintranetMigr/taux-de-change [L,QSA]

RewriteRule ^badm-rental/?$ http://192.168.0.38:8081/ [P]
RewriteRule ^badm-rental/(.*)$ http://192.168.0.38:8081/$1 [P]

RewriteRule ^rental/rental/rollout/?$ http://192.168.0.38:8101/ [P]
RewriteRule ^rental/rental/rollout/(.*)$ http://192.168.0.38:8101/$1 [P]

# Rediriger toutes les requêtes non fichiers vers index.php pour un traitement ultérieur
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]


RewriteEngine On


RewriteRule ^annuaire/?$ /HffintranetMigr/annuaire [L,QSA]
RewriteRule ^annuaire/(.*)$ /HffintranetMigr/annuaire [L,QSA]
RewriteRule ^taux-de-change/?$ /HffintranetMigr/taux-de-change [L,QSA]
RewriteRule ^taux-de-change/(.*)$ /HffintranetMigr/taux-de-change [L,QSA]
# Rediriger toutes les requêtes non fichiers vers index.php pour un traitement ultérieur
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]
# Modules JS importés sans ?v= : forcer la revalidation (304 via ETag) pour ne pas garder une ancienne version
<IfModule mod_headers.c>
    <FilesMatch "\.js$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
