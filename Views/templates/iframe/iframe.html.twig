<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<link href="{{ App.base_path }}/Views/assets/favicon.jpg" type="image/x-icon" rel="shortcut icon">
		<link href="{{ App.base_path }}/Views/css/styles.css?v={{ App.browserHash }}" rel="stylesheet"/>
		<link href="{{ App.base_path }}/Views/css/style.css?v={{ App.browserHash }}" rel="stylesheet"/>
		<title>{{ pageTitle }}</title>
		<style>
			html,
			body {
				margin: 0;
				padding: 0;
				width: 100%;
				height: 100%;
				overflow: hidden;
			}
			iframe {
				position: fixed;
				top: 75px;
				left: 0;
				width: 100vw;
				height: calc(100vh - 75px);
				border: none;
			}
		</style>
	</head>
	<body>
		<div class="main-content">
			{% block nav %}
				{% include "/partials/_navigation.html.twig" %}
			{% endblock %}

			<div class="content">
				<iframe src="{{ url }}" frameborder="0"></iframe>
			</div>
		</div>

		{% include "/shared/_modalConfirmation.html.twig" %}

		<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
		<script src="{{ App.base_path }}/Views/js/scripts.js?v={{ App.browserHash }}" type="module"></script>
	</body>
</html>
