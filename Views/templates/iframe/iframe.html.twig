<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<link href="{{ App.base_path }}/Views/assets/favicon.jpg" type="image/x-icon" rel="shortcut icon">
		<title>{{ pageTitle }}</title>
		<style>
			html,
			body {
				margin: 0;
				padding: 0;
				width: 100%;
				height: 100%;
				overflow: hidden;
			}
			iframe {
				position: fixed;
				top: 0;
				left: 0;
				width: 100vw;
				height: 100vh;
				border: none;
			}
		</style>
	</head>
	<body>
		<iframe src="{{ url }}" frameborder="0"></iframe>
	</body>
</html>
