{% extends "baseTemplate.html.twig" %}

{% block title %}
	Journal copies DocuWare
{% endblock %}

{% block stylesheets %}
	<link href="{{ App.base_path }}/Views/css/new.css?v={{ App.browserHash }}" rel="stylesheet"/>
{% endblock %}

{% block content %}
	<div class="container-fluid">
		<div class="card">
			<div class="card-body">
				<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
					<h3 class="perso-titre mb-0">
						JOURNAL DES COPIES VERS DOCUWARE
						{% if nbEchecsNonVus > 0 %}
							<span class="badge bg-danger">{{ nbEchecsNonVus }} échec(s) non vu(s)</span>
						{% endif %}
					</h3>
					{% if nbEchecsNonVus > 0 %}
						<a href="{{ path('journal_copie_docuware_echecs_vus') }}" class="btn btn-outline-warning btn-sm">Marquer les échecs comme vus</a>
					{% endif %}
				</div>

				<form method="get" action="{{ path('journal_copie_docuware_index') }}" class="row g-2 align-items-end mb-3">
					<div class="col-12 col-md-4">
						<label for="recherche" class="form-label mb-0">N° document (OR, DIT, DA...), nom de fichier ou utilisateur</label>
						<input type="text" id="recherche" name="recherche" value="{{ recherche }}" class="form-control form-control-sm">
					</div>
					<div class="col-6 col-md-2">
						<label for="date_debut" class="form-label mb-0">Du</label>
						<input type="date" id="date_debut" name="date_debut" value="{{ dateDebut ? dateDebut|date('Y-m-d') : '' }}" class="form-control form-control-sm">
					</div>
					<div class="col-6 col-md-2">
						<label for="date_fin" class="form-label mb-0">Au</label>
						<input type="date" id="date_fin" name="date_fin" value="{{ dateFin ? dateFin|date('Y-m-d') : '' }}" class="form-control form-control-sm">
					</div>
					<div class="col-6 col-md-2">
						<div class="form-check">
							<input type="checkbox" id="echec" name="echec" value="1" class="form-check-input" {{ echecSeulement ? 'checked' : '' }}>
							<label for="echec" class="form-check-label">Échecs uniquement</label>
						</div>
					</div>
					<div class="col-6 col-md-2 d-flex gap-2">
						<button type="submit" class="btn btn-warning btn-sm">Rechercher</button>
						<a href="{{ path('journal_copie_docuware_index') }}" class="btn btn-outline-secondary btn-sm">Effacer</a>
					</div>
				</form>

				<p class="text-muted small mb-2">{{ copies|length }} copie(s) affichée(s) (300 maximum, les plus récentes en premier).</p>

				<div class="table-responsive">
					<table class="table table-sm table-bordered table-hover align-middle">
						<thead class="table-dark">
							<tr>
								<th>Date</th>
								<th>Utilisateur</th>
								<th>Résultat</th>
								<th>Fichier</th>
								<th>Chemin du fichier à copier</th>
								<th>Chemin de destination (DocuWare)</th>
								<th>Erreur</th>
								<th>Page</th>
							</tr>
						</thead>
						<tbody>
							{% for copie in copies %}
								<tr class="{{ copie.succes ? '' : 'table-danger' }} {{ copie.succes or copie.estVu ? '' : 'fw-bold' }}">
									<td class="text-nowrap">{{ copie.dateCopie ? copie.dateCopie|date('d/m/Y H:i:s') : '-' }}</td>
									<td>{{ copie.utilisateur ?: '-' }}</td>
									<td class="text-nowrap">
										{% if copie.succes %}
											<span class="badge bg-success">OK</span>
										{% else %}
											<span class="badge bg-danger">ÉCHEC</span>
										{% endif %}
										{% if copie.nbTentatives > 1 %}
											<small>({{ copie.nbTentatives }} tentatives)</small>
										{% endif %}
									</td>
									<td>
										{{ copie.nomFichier }}<br>
										<small class="text-muted">{{ copie.dossierDocuware }}</small>
									</td>
									<td>
										{% if copie.sourceExiste %}
											<span class="badge bg-secondary">{{ (copie.tailleSource / 1024)|number_format(0, ',', ' ') }} Ko</span>
										{% else %}
											<span class="badge bg-danger">introuvable</span>
										{% endif %}
										<small class="text-break user-select-all">{{ copie.fichierSource }}</small>
									</td>
									<td>
										<small class="text-break user-select-all">{{ copie.destination }}</small>
									</td>
									<td><small>{{ copie.messageErreur ?: '' }}</small></td>
									<td><small class="text-muted text-break">{{ copie.url }}</small></td>
								</tr>
							{% else %}
								<tr>
									<td colspan="8" class="text-center text-muted">Aucune copie trouvée.</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>
{% endblock %}
