{% extends "baseTemplate.html.twig" %}

{% block title %}
    Création Demande Diagnostic Pneu
{% endblock %}

{% block stylesheets %}
    <link href="{{ App.base_path }}/Views/css/new.css?v=2026.07.03.14.50" rel="stylesheet"/>
{% endblock %}

{% import "macroForm.html.twig" as macroForm %}

{% block content %}

    <div class="container mt-6 mb-4">

        <div class="card">

            <div class="card-body">

                <div class="container">

                    <div class="row mb-3">

                        <div class="col-md-11">

                            <h3 class="perso-titre">
                                Formulaire Demande Diagnostic Pneu
                            </h3>

                            {% include "/partials/_notification.html.twig" %}

                        </div>

                        <div class="col-md-1">

                            <a href="{{ path('profil_acceuil') }}"
                                class="tablinks p-2 btn btn-outline-warning"
                                style="text-decoration:none;color:black">

                                Retour

                            </a>

                        </div>

                    </div>

                    {{ form_start(form,{
                    attr:{
                    id:'diagnostic-pneu-form',
                    'data-form-type':'formulaire-new-diagnostic-pneu'
                    }
                    }) }}

                    {{ form_errors(form) }}

                    {# ========================================= #}
                    {# Informations générales                    #}
                    {# ========================================= #}

                    {{ macroForm.sousTitre('Informations générales',{class:'sousTitre'}) }}

                    <div class="row">

                        <div class="col-md-4">

                            {{ form_row(form.livraison) }}

                        </div>

                    </div>

                    {# ========================================= #}
                    {# Informations matériel                     #}
                    {# ========================================= #}

                    {{ macroForm.sousTitre('Information matériel',{class:'sousTitre'}) }}

                    <div class="row">

                        <div class="col-md-6">

                            {{ form_row(form.id_materiel) }}

                        </div>

                        <div class="col-md-6">

                            {{ form_row(form.numero_parc_materiel) }}

                        </div>

                    </div>

                    {# ========================================= #}
                    {# Informations pneus                        #}
                    {# ========================================= #}

                    {{ macroForm.sousTitre('Informations pneus',{class:'sousTitre'}) }}

                    <div class="row">

                        <div class="col-md-4">

                            {{ form_row(form.nbPneuSurMachine) }}

                        </div>

                        <div class="col-md-4">

                            {{ form_row(form.nbPneuSecours) }}

                        </div>

                        <div class="col-md-4">

                            {{ form_row(form.nbPneuADiagnostiquer) }}

                        </div>

                    </div>

                    {# ========================================= #}
                    {# Observation                               #}
                    {# ========================================= #}

                    {{ macroForm.sousTitre('Observation',{class:'sousTitre'}) }}

                    <div class="row">

                        <div class="col-12">

                            {{ form_row(form.observation) }}

                        </div>

                    </div>

                    <div class="d-flex justify-content-end mt-4">

                        <button
                        type="submit"
                        class="btn bouton"
                        id="bouton-diagnostic-pneu"
                        data-confirmation
                        data-form="#diagnostic-pneu-form"
                        data-confirmation-message="Vous êtes en train d'enregistrer une demande de diagnostic pneu">

                        <i class="fas fa-save"></i>
                        Enregistrer

                    </button>

                </div>

                {{ form_end(form) }}

            </div>

        </div>

    </div>

    </div>

{% endblock %}

{% block javascript %}

    <script
    type="module"
    src="{{ App.base_path }}/Views/js/ddd/demandeDiagnosticPneu.js?v=2026.07.03.14.50">
    </script>

{% endblock %}