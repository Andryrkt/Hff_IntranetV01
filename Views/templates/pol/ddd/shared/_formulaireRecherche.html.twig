{% import "macroForm.html.twig" as macroForm %}

<!-- DEBUT recherche -->
<div class="accordion" id="formAccordion">
    <div class="accordion-item">
        <h2 class="accordion-header">
            <button class="accordion-button enteteAccordion" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
                Formulaire de recherche
            </button>
        </h2>
        <div id="collapseOne" class="accordion-collapse collapse" data-bs-parent="#formAccordion">
            <div class="accordion-body">
                {{ form_start(form, {'method': 'GET'}) }}
                <div class="row">
                    <div class="col-12 col-md-3">
                        {{ form_row(form.numeroDemande) }}
                        {{ form_row(form.demandeur) }}
                        {{ form_row(form.statut) }}
                        {{ form_row(form.idChantier) }}
                    </div>
                    <div class="col-12 col-md-3">
                        {{ form_row(form.dateCreationDebut) }}
                        {{ form_row(form.dateCreationFin) }}
                        {{ form_row(form.numeroParcMateriel) }}
                        {{ form_row(form.numeroDit) }}
                    </div>
                    <div class="col-12 col-md-3">
                        {{ form_row(form.numeroOr) }}
                        {{ form_row(form.livraison) }}
                        {# Optionnel : ajouter un champ pour le nombre de pneus à diagnostiquer #}
                        {# {{ form_row(form.nbPneuADiagnostiquer) }} #}
                    </div>
                    <div class="col-12 col-md-3">
                        {# Espace pour d'autres filtres si besoin #}
                        {# Par exemple : type de matériel, etc. #}
                    </div>
                </div>

                <div class="d-flex justify-content-end mb-2">
                    <button class="btn btn-warning fw-bold" type="submit">
                        <i class="fas fa-search"></i>
                        Recherche
                    </button>
                </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>