{% extends "baseTemplate.html.twig" %}

{% block title %}
	Planning de commande Magasin
{% endblock %}

{% block stylesheets %}
	<link rel="stylesheet" href="{{ App.base_path }}/Views/css/list.css?v=2026.08.06.1">
	<link rel="stylesheet" href="{{ App.base_path }}/Views/css/planning/planning.css?v=2026.08.06.1">
{% endblock %}

{% block overlay %}
	{% include "/shared/_overlay.html.twig" %}
{% endblock %}

{% block content %}
	<div class="sticky-header-titre">
		<div class="container">
			<div class="accordion" id="formAccordion">
				<div class="accordion-item">
					<h2 class="accordion-header">
						<button class="accordion-button enteteAccordion" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne" aria-expanded="true" aria-controls="collapseOne">
							Formulaire de recherche
						</button>
					</h2>
					<div id="collapseOne" class="accordion-collapse collapse show" data-bs-parent="#formAccordion">
						<div class="accordion-body">
							<input type="text" class="form-control" id="rechercheCommandeFournisseur" placeholder="Saisir un numéro de commande fournisseur, une référence, un acheteur...">
						</div>
					</div>
				</div>
			</div>
			<div class="d-flex justify-content-between">
				<div class="my-2 d-flex flex-row">
					<div class="fw-bold" id="tout-afficher">
						<small>TOUT AFFICHER |</small>
					</div>
					<div id="partiellement-facture">
						<i class="fa-solid fa-circle text-warning"></i>
						<small>Partiellement facturé |</small>
					</div>
					<div id="partiellement-dispo">
						<i class="fa-solid fa-circle text-info"></i>
						<small>Partiellement dispo |</small>
					</div>
					<div id="complet-non-facture">
						<i class="fa-solid fa-circle text-primary"></i>
						<small>Complet non facturé |</small>
					</div>
					<div id="complet-facture">
						<i class="fa-solid fa-circle text-success"></i>
						<small>Complet facturé |</small>
					</div>
					<div id="back-order">
						<i class="fa-solid fa-circle text-danger"></i>
						<small>Back Order / Error</small>
					</div>
				</div>
			</div>
		</div>
	</div>
	<div class="container-fluid">
		<table class="table table-sticky">
			<thead class="table-dark">
				<tr>
					<th>Fournisseur</th>
					<th>Agence / Service</th>
					<th>Code Fourn.</th>
					{% for month in uniqueMonths %}
						<th class="{{ month.current ? 'bg-warning text-dark' : '' }}">
							{{ month.month|upper }}
							{{ month.year }}
						</th>
					{% endfor %}
				</tr>
			</thead>
			<tbody>
				{% for item in preparedData %}
					<tr>
						<td class="text-start">{{ item.fournisseur }}</td>
						<td>{{ item.agenceService }}</td>
						<td>{{ item.codeFourn }}</td>
						{% for month in uniqueMonths %}
							<td>
								{% set commandes = item.commandes[month.key] | default([]) %}
								{% if commandes|length > 0 %}
									{% for commande in commandes %}
										{% set classe = '' %}
										{% if commande.statut == 'Partiellement facturé' %}
											{% set classe = 'bg-warning text-white' %}
										{% elseif commande.statut == 'Partiellement dispo' %}
											{% set classe = 'bg-info text-white' %}
										{% elseif commande.statut == 'Complet non facturé' %}
											{% set classe = 'bg-primary text-white' %}
										{% elseif commande.statut == 'Complet facturé' %}
											{% set classe = 'bg-success text-white' %}
										{% endif %}
										<span class="d-inline-block px-2 py-1 rounded text-wrap {{ classe }}" title="{{ commande.statut }}">
											{{ commande.numero }}
										</span><br>
									{% endfor %}
								{% else %}
									-
								{% endif %}
							</td>
						{% endfor %}
					</tr>
				{% endfor %}
			</tbody>
		</table>
	</div>
{% endblock %}

{% block javascript %}
	<script src="{{ App.base_path }}/Views/js/utils/positionSticky.js?v=2026.08.06.1"></script>
{% endblock %}
