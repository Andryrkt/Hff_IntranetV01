{% extends "baseTemplate.html.twig" %}

{% block title %}
	Magasin - Soumission commandes fournisseur à génerer
{% endblock %}

{% block stylesheets %}
	<link rel="stylesheet" href="{{ App.base_path }}/Views/css/list.css?v={{ App.browserHash }}">
	<link rel="stylesheet" href="{{ App.base_path }}/Views/css/new.css?v={{ App.browserHash }}">
	<link rel="stylesheet" href="{{ App.base_path }}/Views/css/magasin/magasin.css?v={{ App.browserHash }}">
{% endblock %}


{% block content %}
	<div class="container-spaced mt-6 mb-4">
		<div class="card p-4">
			<h3 class="perso-titre">Soumission commandes fournisseur à génerer</h3>
			{% include "/partials/_notification.html.twig" %}
			{{ form_start(form, {'attr': {'id': 'myForm', 'enctype': 'multipart/form-data'}}) }}
			{{ form_errors(form) }}
			<div class="row my-2">
				<div class="col-md-3">
					<div class="row align-items-center">
						{{ form_label(form.numCmde) }}
						<div class="col-6">
							{{ form_widget(form.numCmde) }}
						</div>
						<div class="col-6">
							<button type="button" class="btn bouton-brouillon border text-black" id="genererPdf">
								<i class="fa-solid fa-file-pdf"></i>
								Générer PDF
							</button>
						</div>
					</div>
				</div>
				<div class="col-md-3">
					<p class="mb-0">
						Vous pouvez insérer
						<strong>des pièces jointes (PDF)</strong>
						à fusionner après la commande
					</p>
					{% include '/partials/_dropZoneFileMultiple.html.twig' with {'id': '2', 'form': form, 'fieldName': 'piecesJointesPdf', 'classBtn': 'btn-warning'} %}
				</div>
			</div>
			<div id="viewer-container" class="d-none">
				<div id="file-viewer">
					<ul class="nav nav-tabs" role="tablist">
						<li class="nav-item" role="presentation">
							<button class="nav-link active" id="tab1-tab" data-bs-toggle="tab" data-bs-target="#tab1" type="button" role="tab">Commande à valider</button>
						</li>
						<li class="nav-item" role="presentation">
							<button class="nav-link" id="tab2-tab" data-bs-toggle="tab" data-bs-target="#tab2" type="button" role="tab">Pièces jointes</button>
						</li>
					</ul>
					<div class="tab-content border border-top-0 p-3">
						<div class="tab-pane fade show active" id="tab1" role="tabpanel">
							<div class="position-relative w-100 border rounded overflow-hidden" style="height:1000px;">
								<iframe id="pdf-iframe" name="pdf-iframe" src="" class="position-absolute top-0 start-0 w-100 h-100 border-0"></iframe>
							</div>
						</div>
						<div class="tab-pane fade" id="tab2" role="tabpanel">
							<div id="file-list-2" class="mt-3"></div>
						</div>
					</div>
				</div>
			</div>
			<div class="d-flex justify-content-end mt-2">
				<button type="submit" class="bouton-principal" id="validationBtn" style="display:none ;">
					<i class="fas fa-paper-plane"></i>
					Soumettre à validation
				</button>
			</div>
			{{ form_end(form) }}
		</div>
	</div>
{% endblock %}

{% block javascript %}
	<script src="{{ App.base_path }}/Views/js/magasin/commande/soumissionCommandeFournisseur.js?v={{ App.browserHash }}" type="module"></script>
{% endblock %}
