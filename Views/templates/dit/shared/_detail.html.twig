{% import "macroForm.html.twig" as macroForm %}

<div class="row">
	<div class="col-md-11">
		<h3 class="perso-titre">
			Détail du demande d'intervention
		</h3>
	</div>
	<div class="col-md-1">
		<a href="{{ path("dit_index")}}" class="btn btn-sm bg-warning fw-bold d-flex align-items-center justify-content-center">Liste des DIT</a>
	</div>
</div>

<div class="row">
	{# COLONNE 1 : DIT #}
	<div class="col-12 col-md-4">
		{{ macroForm.sousTitre('DIT', {class: 'sousTitre'})}}
		<div class="row">
			<div class="col-12 col-md-6">{{ macroForm.affichage2('Numero DIT', dit.numeroDemandeIntervention, 'mb-2')}}</div>
			<div class="col-12 col-md-6">{{ macroForm.affichage2('Date Demande', dit.dateDemande|date('d/m/Y'), 'mb-2')}}</div>
		</div>
		<div class="row">
			<div class="col-12">{{ macroForm.affichage2('Statut DIT', '', 'mb-2')}}</div>
			<div class="col-12">{{ macroForm.affichage2('Objet de la demande', dit.objetDemande, 'mb-2')}}</div>
			<div class="col-12">{{ macroForm.affichageTextarea('Détail de la demande', dit.detailDemande, 'mb-2')}}</div>
		</div>
		<div class="row">
			<div class="col-12 col-md-6">{{ macroForm.affichage2('Type de document', dit.typeDocument, 'mb-2')}}</div>
			<div class="col-12 col-md-6">{{ macroForm.affichage2('Demande de devis', dit.demandeDevis, 'mb-2')}}</div>
		</div>
		<div class="row">
			<div class="col-12 col-md-6">{{ macroForm.affichage2('Livraison Partielle', dit.livraisonPartiel, 'mb-2')}}</div>
			<div class="col-12 col-md-6">{{ macroForm.affichage2('Avis de recouvrement', dit.avisRecouvrement, 'mb-2')}}</div>
		</div>
		<div class="row">
			<div class="col-12 col-md-6">{{ macroForm.affichage2('Catégorie de demande', dit.categorieDemande.libelleCategorieAteApp, 'mb-2')}}</div>
			<div class="col-12 col-md-6">{{ macroForm.affichage2('Interne et Externe', dit.internetExterne, 'mb-2')}}</div>
		</div>
	</div>
	{# FIN DIT #}

	{# COLONNE 2 : OR, COMMANDE, AGENCE/SERVICE, INFO CLIENT #}
	<div class="col-12 col-md-4">
		{{ macroForm.sousTitre('Or', {class: 'sousTitre'})}}
		<div class="row">
			<div class="col-12 col-md-6">{{ macroForm.affichage2('N° Or', dit.numeroOr, 'mb-2')}}</div>
			<div class="col-12 col-md-6">{{ macroForm.affichage2('Statut Or', dit.statutOr, 'mb-2')}}</div>
			{% set mots_a_supprimer = ['Chef section', 'Chef de section', 'Responsable section', 'Chef d\'équipe'] %}
			<div class="col-12">{{ macroForm.affichage2('Section affectée', dit.sectionAffectee | remove_words(mots_a_supprimer), 'mb-2')}}</div>
		</div>

		{{ macroForm.sousTitre('Commande', {class: 'sousTitre'})}}
		<table class="table rounded mt-1">
			<thead class="table">
				<tr>
					<th>N°</th>
					<th>Date</th>
					<th>Statut</th>
				</tr>
			</thead>
			<tbody>
				{% for command in commandes %}
					<tr>
						<td>{{ command.slor_numcf}}</td>
						<td>{{ command.fcde_date | date("d/m/Y")}}</td>
						<td>--</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>

		{{ macroForm.sousTitre('Agence et Service', {class: 'sousTitre'})}}
		<div class="row">
			<div class="col-12 col-md-6">{{ macroForm.affichage2('Débiteur', dit.agenceServiceDebiteur, 'mb-2')}}</div>
			<div class="col-12 col-md-6">{{ macroForm.affichage2('Emetteur', dit.agenceServiceEmetteur, 'mb-2')}}</div>
		</div>

		{{ macroForm.sousTitre('Info Client', {class: 'sousTitre'})}}
		<div class="row">
			<div class="col-12 col-md-6">{{ macroForm.affichage2('Nom du client', dit.nomClient, 'mb-2')}}</div>
			<div class="col-12 col-md-6">{{ macroForm.affichage2('N° téléphone', dit.numeroTel, 'mb-2')}}</div>
			<div class="col-12">{{ macroForm.affichage2('Client sous contrat', dit.clientSousContrat, 'mb-2')}}</div>
		</div>
	</div>
	{# FIN COLONNE 2 #}

	{# COLONNE 3 : MATERIEL, BILAN, INTERVENTION, PIECES JOINTES #}
	<div class="col-12 col-md-4">
		{{ macroForm.sousTitre('Information Matériel', {class: 'sousTitre'})}}
		<div class="row">
			<div class="col-12 col-md-6">
				{{ macroForm.affichage2('Id Materiel', dit.idMateriel, 'mb-2')}}
				{{ macroForm.affichage2('n° Serie', dit.numSerie, 'mb-2')}}
				{{ macroForm.affichage2('n° Parc', dit.numParc, 'mb-2')}}
				{{ macroForm.affichage2('Constructeur', dit.constructeur, 'mb-2')}}
			</div>
			<div class="col-12 col-md-6">
				{{ macroForm.affichage2('Designation', dit.designation, 'mb-2')}}
				{{ macroForm.affichage2('Km', dit.km, 'mb-2')}}
				{{ macroForm.affichage2('Modele', dit.modele, 'mb-2')}}
				{{ macroForm.affichage2('Casier', dit.casier, 'mb-2')}}
				{{ macroForm.affichage2('Heure', heure, 'mb-2')}}
			</div>
		</div>

		{{ macroForm.sousTitre('Bilan Financière', {class: 'sousTitre mb-3'})}}
		<div class="cadre">
			<div class="row">
				<div class="col-12 col-md-6">
					{{ macroForm.affichage2('CA', dit.chiffreAffaire | number_format(2, ',', '.'), 'mb-2')}}
					{{ macroForm.affichage2('Charge d\'entretien', dit.chargeEntretient | number_format(2, ',', '.'), 'mb-2')}}
					{{ macroForm.affichage2('Charge Locative', dit.chargeLocative | number_format(2, ',', '.'), 'mb-2')}}
					{{ macroForm.affichage2('Résultat d\'exploitation', dit.resultatExploitation | number_format(2, ',', '.'), 'mb-2')}}
				</div>
				<div class="col-12 col-md-6">
					{{ macroForm.affichage2('Coût d\'acquisition', dit.coutAcquisition | number_format(2, ',', '.'), 'mb-2')}}
					{{ macroForm.affichage2('Amortissement', dit.amortissement | number_format(2, ',', '.'), 'mb-2')}}
					{{ macroForm.affichage2('VNC', dit.valeurNetComptable | number_format(2, ',', '.'), 'mb-2')}}
				</div>
			</div>
		</div>

		{{ macroForm.sousTitre('Intervention', {class: 'sousTitre'})}}
		<div class="row">
			<div class="col-12 col-md-6">{{ macroForm.affichage2('Niveau d\'urgence', dit.idNiveauUrgence, 'mb-2')}}</div>
			<div class="col-12 col-md-6">{{ macroForm.affichage2('Date prévu travaux', dit.datePrevueTravaux|date('d/m/Y'), 'mb-2')}}</div>
		</div>
		{{ macroForm.sousTitre('Réparation', {class: 'sousTitre'})}}
		<div class="row">
			<div class="col-12 col-md-6">{{ macroForm.affichage2('Type de réparation', dit.typeReparation, 'mb-2')}}</div>
			<div class="col-12 col-md-6">{{ macroForm.affichage2('Réparation réalisé par', dit.reparationRealise, 'mb-2')}}</div>
		</div>

		{{ macroForm.sousTitre('Pièces Jointes', {class: 'sousTitre'})}}
		{{ macroForm.affichageFile('Pièce jointe 01', dit.pieceJoint01, "/Upload/dit/" ~ dit.numeroDemandeIntervention)}}
		{{ macroForm.affichageFile('Pièce jointe 02', dit.pieceJoint02, "/Upload/dit/" ~ dit.numeroDemandeIntervention)}}
		{{ macroForm.affichageFile('Pièce jointe 03', dit.pieceJoint03, "/Upload/dit/" ~ dit.numeroDemandeIntervention)}}
	</div>
	{# FIN COLONNE 3 #}
</div>
