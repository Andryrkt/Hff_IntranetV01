{% import "macroForm.html.twig" as macroForm %}

<div class="row">
	<div class="col-md-11">
		<h3 class="perso-titre">
			Détail du demande d'intervention
		</h3>
	</div>
	<div class="col-md-1">
		<a href="{{ path("dit_index")}}" class="btn btn-list-dit">Liste des DIT</a>
	</div>
</div>

<div class="row">
	<div class="col-12 col-md-4">
		{{ macroForm.sousTitre('DIT', {class: 'sousTitre'})}}
		<div class="row">
			<div class="col-12 col-md-4">{{ macroForm.affichage2('Numero DIT', dit.numDit, 'mb-1')}}</div>
			<div class="col-12 col-md-4">{{ macroForm.affichage2('Date Demande', dit.dateDemande, 'mb-1')}}</div>
			<div class="col-12 col-md-4">{{ macroForm.affichage2('Statut DIT', dit.statutDit, "mb-1 border-0 " ~ dit.statutCssClass, "box-shadow: 1px 1px 2px #6f6f6f;")}}</div>
		</div>
		<div class="row">
			<div class="col-12">{{ macroForm.affichage2('Objet de la demande', dit.objetDemande, 'mb-1')}}</div>
			<div class="col-12">{{ macroForm.affichageTextarea('Détail de la demande', dit.detailDemande, 'mb-1')}}</div>
		</div>
		<div class="row">
			<div class="col-12 col-md-4">
				{{ macroForm.affichage2('Type de document', dit.typeDocument, 'mb-1')}}
				{{ macroForm.affichage2('Avis de recouvrement', dit.avisRecouvrement, 'mb-1')}}
			</div>
			<div class="col-12 col-md-4">
				{{ macroForm.affichage2('Demande de devis', dit.demandeDevis, 'mb-1')}}
				{{ macroForm.affichage2('Catégorie de demande', dit.categorieDemandeLibelle, 'mb-1')}}
			</div>
			<div class="col-12 col-md-4">
				{{ macroForm.affichage2('Livraison Partielle', dit.livraisonPartiel, 'mb-1')}}
				{{ macroForm.affichage2('Interne et Externe', dit.internetExterne, 'mb-1')}}
			</div>
		</div>
	</div>

	<div class="col-12 col-md-4">
		{{ macroForm.sousTitre('Or', {class: 'sousTitre'})}}
		<div class="row">
			<div class="col-12 col-md-4">{{ macroForm.affichage2('N° Or', dit.numeroOr, 'mb-1')}}</div>
			<div class="col-12 col-md-4">{{ macroForm.affichage2('Statut Or', dit.statutOr, 'mb-1')}}</div>
			<div class="col-12 col-md-4">{{ macroForm.affichage2('Section affectée', dit.sectionAffectee, 'mb-1')}}</div>
		</div>

		{{ macroForm.sousTitre('Agence et Service', {class: 'sousTitre'})}}
		<div class="row">
			<div class="col-12 col-md-6">{{ macroForm.affichage2('Débiteur', dit.agenceServiceDebiteur, 'mb-1')}}</div>
			<div class="col-12 col-md-6">{{ macroForm.affichage2('Emetteur', dit.agenceServiceEmetteur, 'mb-1')}}</div>
		</div>

		{{ macroForm.sousTitre('Info Client', {class: 'sousTitre'})}}
		<div class="row">
			<div class="col-12 col-md-4">{{ macroForm.affichage2('Nom du client', dit.nomClient, 'mb-1')}}</div>
			<div class="col-12 col-md-4">{{ macroForm.affichage2('N° téléphone', dit.numeroTel, 'mb-1')}}</div>
			<div class="col-12 col-md-4">{{ macroForm.affichage2('Client sous contrat', dit.clientSousContrat, 'mb-1')}}</div>
		</div>

		{{ macroForm.sousTitre('Intervention', {class: 'sousTitre'})}}
		<div class="row">
			<div class="col-12 col-md-6">{{ macroForm.affichage2('Niveau d\'urgence', dit.niveauUrgence, 'mb-1')}}</div>
			<div class="col-12 col-md-6">{{ macroForm.affichage2('Date prévu travaux', dit.datePrevueTravauxFormatee, 'mb-1')}}</div>
		</div>
	</div>

	<div class="col-12 col-md-4">
		{{ macroForm.sousTitre('Commande', {class: 'sousTitre'})}}
		<table class="table rounded mt-1">
			<thead class="table">
				<tr>
					<th>N°</th>
					<th>Date</th>
					<th>Statut</th>
				</tr>
			</thead>
			<tbody>
				{% for command in dit.commandes %}
					<tr>
						<td>{{ command.numero }}</td>
						<td>{{ command.dateFormatee }}</td>
						<td>{{ command.statut }}</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	</div>
</div>

<div class="row">
	<div class="col-12 col-md-4">
		{{ macroForm.sousTitre('Bilan Financière', {class: 'sousTitre mb-3'})}}
		<div class="cadre">
			<div class="row">
				<div class="col-12 col-md-6">
					{{ macroForm.affichage2('CA', dit.chiffreAffaireFormate, 'mb-1')}}
					{{ macroForm.affichage2('Charge d\'entretien', dit.chargeEntretientFormate, 'mb-1')}}
				{{ macroForm.affichage2('Charge Locative', dit.chargeLocativeFormate, 'mb-1')}}
				{{ macroForm.affichage2('Résultat d\'exploitation', dit.resultatExploitationFormate, 'mb-1')}}
				</div>
				<div class="col-12 col-md-6">
					{{ macroForm.affichage2('Coût d\'acquisition', dit.coutAcquisitionFormate, 'mb-1')}}
				{{ macroForm.affichage2('Amortissement', dit.amortissementFormate, 'mb-1')}}
				{{ macroForm.affichage2('VNC', dit.valeurNetComptableFormatee, 'mb-1')}}
			</div>
		</div>
	</div>
</div>
<div class="col-12 col-md-4">
	{{ macroForm.sousTitre('Information Matériel', {class: 'sousTitre'})}}
	<div class="row">
		<div class="col-12 col-md-4">{{ macroForm.affichage2('Id Materiel', dit.idMateriel, 'mb-1')}}</div>
		<div class="col-12 col-md-4">{{ macroForm.affichage2('n° Serie', dit.numSerie, 'mb-1')}}</div>
		<div class="col-12 col-md-4">{{ macroForm.affichage2('n° Parc', dit.numParc, 'mb-1')}}</div>
		<div class="col-12 col-md-6">
			{{ macroForm.affichage2('Constructeur', dit.constructeur, 'mb-1')}}
			{{ macroForm.affichage2('Designation', dit.designation, 'mb-1')}}
			{{ macroForm.affichage2('Km', dit.km, 'mb-1')}}
		</div>
		<div class="col-12 col-md-6">
			{{ macroForm.affichage2('Modele', dit.modele, 'mb-1')}}
			{{ macroForm.affichage2('Casier', dit.casier, 'mb-1')}}
			{{ macroForm.affichage2('Heure', dit.heure, 'mb-1')}}
		</div>
	</div>
</div>
<div class="col-12 col-md-4">
	{{ macroForm.sousTitre('Réparation', {class: 'sousTitre'})}}
	<div class="row">
		<div class="col-12 col-md-6">{{ macroForm.affichage2('Type de réparation', dit.typeReparation, 'mb-1')}}</div>
		<div class="col-12 col-md-6">{{ macroForm.affichage2('Réparation réalisé par', dit.reparationRealise, 'mb-1')}}</div>
	</div>

	{{ macroForm.sousTitre('Pièces Jointes', {class: 'sousTitre'})}}
	{{ macroForm.affichageFile('Pièce jointe 01', dit.pieceJoint01, "/Upload/dit/" ~ dit.numeroDemandeIntervention)}}
	{{ macroForm.affichageFile('Pièce jointe 02', dit.pieceJoint02, "/Upload/dit/" ~ dit.numeroDemandeIntervention)}}
	{{ macroForm.affichageFile('Pièce jointe 03', dit.pieceJoint03, "/Upload/dit/" ~ dit.numeroDemandeIntervention)}}
</div></div>
