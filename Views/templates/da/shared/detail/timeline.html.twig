<div class="row mb-3">
	<div class="col-md-11">
		<h3 class="perso-titre">Timeline de la DA</h3>
	</div>
	<div class="col-md-1">
		<a href="{{ path("list_da") }}" class="btn btn-list-da">Liste des DA</a>
	</div>
</div>

<div class="timeline-section timeline-single">
	<div class="timeline-section-header">Demande d'achat</div>
	<div class="timeline-block">
		<div class="timeline-block-title">DA n° {{ timelineData.numeroDa }}</div>
		{% for item in timelineData.DA %}
			<div class="timeline-item {{ item.dotClass ? 'is-done' }}">
				<div class="timeline-dot {{ item.dotClass ?: 'timeline-dot-empty' }}"></div>
				<div class="timeline-content">
					<div class="d-flex flex-row align-items-start gap-4">
						<div class="timeline-date">{{ item.date }}</div>
						<div>
							<div class="timeline-status {{ item.dotClass }}">
								{{ item.statut }}
							</div>
							{% if item.action %}
								<div class="timeline-action {{ item.dotClass }}">{{ item.action }}</div>
							{% endif %}
						</div>
					</div>
					<div class="timeline-duration mt-3">{{ item.nbrJours }}</div>
				</div>
			</div>
		{% endfor %}
	</div>
</div>

{% if timelineData.OR|length > 0 %}
	<div class="timeline-section timeline-single">
		<div class="timeline-section-header">Ordre de réparation</div>
		<div class="timeline-block">
			{% if timelineData.numeroOr %}
				<div class="timeline-block-title">OR n° {{ timelineData.numeroOr }}</div>
			{% endif %}
			{% for item in timelineData.OR %}
				<div class="timeline-item {{ item.dotClass ? 'is-done' }}">
					<div class="timeline-dot {{ item.dotClass ?: 'timeline-dot-empty' }}"></div>
					<div class="timeline-content">
						<div class="d-flex flex-row align-items-center gap-4">
							<div class="timeline-date">{{ item.date }}</div>
							<div class="timeline-status {{ item.dotClass }}">{{ item.statut }}</div>
						</div>
						<div class="timeline-duration mt-3">{{ item.nbrJours }}</div>
					</div>
				</div>
			{% endfor %}
		</div>
	</div>
{% endif %}

{% if timelineData.BC|length > 0 %}
	<div class="timeline-section">
		<div class="timeline-section-header">Bons de commande</div>
		<div class="timeline-scroll-wrap">
			<div class="timeline-scroll-track-top"><div class="timeline-scroll-spacer"></div></div>
			<div class="timeline-scroll-row">
				{% for numeroBC, bcTimeline in timelineData.BC %}
					<div class="timeline-block">
						<div class="timeline-block-title">BC n° {{ numeroBC }}</div>
						{% for item in bcTimeline %}
							<div class="timeline-item {{ item.dotClass ? 'is-done' }}">
								<div class="timeline-dot {{ item.dotClass ?: 'timeline-dot-empty' }}"></div>
								<div class="timeline-content">
									<div class="d-flex flex-row align-items-center gap-4">
										<div class="timeline-date">{{ item.date }}</div>
										<div class="timeline-status {{ item.dotClass }}">{{ item.statut }}</div>
									</div>
									<div class="timeline-duration mt-3">{{ item.nbrJours }}</div>
								</div>
							</div>
						{% endfor %}
					</div>
				{% endfor %}
			</div>
		</div>
	</div>
{% endif %}
