{#
	Bouton « Guide d'utilisation » d'un écran (icône seule, à droite du fil d'Ariane) :
	déclarer dans le template de l'écran, hors des blocs :
	{% set guideSlug = 'identifiant-du-guide' %}
	- utilisateur : visible seulement si le guide est publié ;
	- administrateur : toujours visible (guide, brouillon, ou « Créer le guide »).
#}
{% set guide = guide_utilisateur(slug) %}
{% if guide and guide.publie %}
	{% set label = "Guide d'utilisation" %}
	<a href="{{ path('doc_utilisateur_show', {'slug': slug}) }}" target="_blank" class="fs-4" title="{{ label }}" aria-label="{{ label }}">
		<i class="fas fa-question-circle"></i>
	</a>
{% elseif App.connectedUser.isAdmin %}
	{% if guide %}
		{% set label = "Guide d'utilisation (brouillon)" %}
		<a href="{{ path('doc_utilisateur_show', {'slug': slug}) }}" target="_blank" class="fs-4 text-secondary" title="{{ label }}" aria-label="{{ label }}">
			<i class="fas fa-question-circle"></i>
		</a>
	{% else %}
		{% set label = "Créer le guide « " ~ slug ~ " »" %}
		<a href="{{ path('doc_utilisateur_edit', {'slug': slug}) }}" target="_blank" class="fs-4 text-secondary" title="{{ label }}" aria-label="{{ label }}">
			<i class="fas fa-plus-circle"></i>
		</a>
	{% endif %}
{% endif %}
