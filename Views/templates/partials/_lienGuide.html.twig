{#
	Bouton « Guide d'utilisation » d'un écran :
	{% include 'partials/_lienGuide.html.twig' with {slug: 'identifiant-du-guide'} %}
	- utilisateur : visible seulement si le guide est publié ;
	- administrateur : toujours visible (guide, brouillon, ou « Créer le guide »).
#}
{% set guide = guide_utilisateur(slug) %}
{% if guide and guide.publie %}
	<a href="{{ path('doc_utilisateur_show', {'slug': slug}) }}" target="_blank" class="small">
		<i class="fas fa-question-circle"></i>
		Guide d'utilisation
	</a>
{% elseif App.connectedUser.isAdmin %}
	{% if guide %}
		<a href="{{ path('doc_utilisateur_show', {'slug': slug}) }}" target="_blank" class="small text-secondary">
			<i class="fas fa-question-circle"></i>
			Guide d'utilisation (brouillon)
		</a>
	{% else %}
		<a href="{{ path('doc_utilisateur_edit', {'slug': slug}) }}" target="_blank" class="small text-secondary">
			<i class="fas fa-plus-circle"></i>
			Créer le guide « {{ slug }} »
		</a>
	{% endif %}
{% endif %}
